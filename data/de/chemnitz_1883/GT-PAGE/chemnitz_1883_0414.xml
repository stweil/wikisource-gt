				<Coords points="199,1278 230,1278 230,1284 242,1284 242,1278 254,1278 255,1284 292,1284 292,1278 304,1278 304,1284 350,1284 350,1278 366,1278 384,1285 389,1278 408,1278 408,1284 420,1284 436,1278 465,1278 509,1284 509,1278 521,1278 534,1280 543,1284 545,1278 553,1278 563,1285 582,1285 600,1279 611,1279 641,1286 642,1278 656,1278 663,1284 674,1284 675,1278 687,1278 689,1284 710,1278 721,1278 723,1285 742,1284 760,1278 779,1278 780,1285 790,1285 791,1279 802,1279 804,1286 814,1286 831,1279 839,1279 848,1285 875,1285 877,1279 888,1279 890,1285 901,1280 910,1280 910,1295 872,1295 847,1299 831,1299 779,1294 687,1293 656,1295 242,1295 199,1293" />
